
<odoo>
    <record id="sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

        <xpath expr="//field[@name='date_order']" position="after">
       		<field name='discount' />
       	</xpath>  
        <xpath expr="//button[@name='action_split']" position="after">
                <button name="action_1"
                        type="object"
                        string="level 1"
                        class = 'btn-primary'/>
                <button name="action_2"
                        type="object"
                        string="level 2"
                        class = 'btn-primary'/>
                <button name="action_3"
                        type="object"
                        string="level 3"
                        class = 'btn-primary'/>

        </xpath> 	

    </field>
   </record>
</odoo>