<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_discount_settings" model="ir.ui.view">
        <field name="name">sale.discount.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='discount_sale_order_lines']" position="after">
                <setting string="Discount Approval">
                    <field name="max_discount"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>